# Copy to .env (gitignored) and fill in real values from the Supabase dashboard
# (Project Settings -> API and -> Database). Same DB as the FamilyCompass app:
# project ref pavjjiiztqxbfnxkqobc.
#
# .env holds the service_role key, which BYPASSES RLS — treat it as a master key.
# Never commit .env. See supabase/RUNBOOK.md for how to run DB work.

SUPABASE_URL=https://pavjjiiztqxbfnxkqobc.supabase.co
SUPABASE_ANON_KEY=            # public anon key (also embedded in the site HTML)
SUPABASE_SERVICE_ROLE_KEY=   # full-access API key — bypasses RLS; keep secret
SUPABASE_DB_PASSWORD=         # Postgres password for direct/pooler connections (may be rotated)
